[1.4697, "o", "\u001b[32m+\u001b[0m Created config.\r\n  \u001b[2mhome  \u001b[0m  /tmp/toris-terminal-record-rebeq37k/state\r\n  \u001b[2mconfig\u001b[0m  /tmp/toris-terminal-record-rebeq37k/state/config.json\r\n\r\n\u001b[1mSolo developer harness\u001b[0m\r\n  \u001b[2mproject     \u001b[0m  toris-agent (prj_m3raxsmy2bf852)\r\n  \u001b[2mpath        \u001b[0m  /workspace/toris-agent\r\n  \u001b[2mautonomy    \u001b[0m  L2 (manual apply)\r\n  \u001b[2magents      \u001b[0m  1\r\n  \u001b[2mdaily budget\u001b[0m  $20\r\n  \u001b[2mprovider    \u001b[0m  codex\r\n  \u001b[2mknowledge   \u001b[0m  auto-retrieve\r\n  \u001b[2mchecks      \u001b[0m  npm run lint, npm run test\r\n\r\nNext: \u001b[36mtoris doctor\u001b[0m then \u001b[36mtoris\u001b[0m for the TUI.\r\nPlan: \u001b[36mtoris run \"<goal>\" -p prj_m3raxsmy2bf852 --dry-run\u001b[0m\r\nReview: \u001b[36mtoris patches\u001b[0m, \u001b[36mtoris diff <patchId>\u001b[0m, then \u001b[36mtoris apply <patchId>\u001b[0m.\r\n"]
