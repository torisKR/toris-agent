[29.0882, "o", "\r\r\n\u001b[0J  /help                    \u001b[2mthis list\u001b[0m\r\n  /agent [id]              \u001b[2mshow agents, or switch role\u001b[0m\r\n  /status                  \u001b[2mproject, policy, checks and pending patches\u001b[0m\r\n  /plan <goal>             \u001b[2mpreview a run without executing tasks\u001b[0m\r\n  /run <goal>              \u001b[2mplan, implement and verify a project goal\u001b[0m\r\n  /check                   \u001b[2mrun checks against the current editing files\u001b[0m\r\n  /diff [id]               \u001b[2minspect live edits or a saved patch\u001b[0m\r\n  /receipt [runId]         \u001b[2minspect a run and its verification evidence\u001b[0m\r\n  /model [profile]         \u001b[2mshow the model, or switch profile\u001b[0m\r\n  /autonomy [L1-L5]        \u001b[2mshow or set what runs unattended\u001b[0m\r\n  /skills                  \u001b[2mskill packages in the system prompt\u001b[0m\r\n  /knowledge [query]       \u001b[2msearch local secretary knowledge\u001b[0m\r\n  /reflect [runId|accept]  \u001b[2mpropose or write a tacit note\u001b[0m\r\n  /tools                   \u001b[2mtools the model may call\u001b[0m\r\n"]
[29.0895, "o", "  /usage                   \u001b[2mtokens and turns used so far\u001b[0m\r\n  /clear                   \u001b[2mforget the transcript, keep the session\u001b[0m\r\n  /patches                 \u001b[2mpending isolated diffs\u001b[0m\r\n  /apply [id]              \u001b[2mapply the live isolation or a stored patch\u001b[0m\r\n  /discard [id]            \u001b[2mdrop the live isolation or a stored patch\u001b[0m\r\n  /exit                    \u001b[2mleave (also: q, ctrl-d)\u001b[0m\r\n\r\n\u001b[2m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1G\u001b[0J\u001b[38;5;209m❯\u001b[0m \u001b[3G"]
