{
  "name": "toris-agent",
  "version": "0.2.0",
  "description": "A local-first, multi-agent development harness that turns a goal into planned, executed and verified work — with an evidence receipt for every run.",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "orchestration",
    "claude",
    "codex",
    "automation",
    "local-first"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "toris": "bin/toris.js"
  },
  "main": "src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "for f in $(find bin src test -name \"*.js\"); do node --check \"$f\" || exit 1; done; echo \"syntax ok\"",
    "toris": "node bin/toris.js",
    "build:native": "cargo build --release --manifest-path crates/toris-native/Cargo.toml",
    "pack:native": "node scripts/pack-native.js",
    "bench": "node scripts/bench.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torisKR/toris-agent.git"
  },
  "bugs": {
    "url": "https://github.com/torisKR/toris-agent/issues"
  },
  "homepage": "https://github.com/torisKR/toris-agent#readme",
  "dependencies": {},
  "optionalDependencies": {
    "@toris-agent/native-darwin-arm64": "0.2.0",
    "@toris-agent/native-darwin-x64": "0.2.0",
    "@toris-agent/native-linux-x64-gnu": "0.2.0",
    "@toris-agent/native-linux-arm64-gnu": "0.2.0",
    "@toris-agent/native-win32-x64-msvc": "0.2.0"
  }
}
