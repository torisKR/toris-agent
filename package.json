{
  "name": "toris-agent-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Toris Agent — a local-first multi-agent development harness for solo founders",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build && pnpm --filter toris-agent run build",
    "clean": "pnpm -r exec rm -rf dist .tsbuildinfo",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
